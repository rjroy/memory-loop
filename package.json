{
  "name": "memory-loop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.4.3",
  "scripts": {
    "daemon": "bun --no-env-file backend/runtime.ts",
    "setup:transport": "bun --no-env-file backend/setup-transport.ts",
    "check:daemon": "bun --no-env-file backend/check-daemon.ts",
    "dev": "bun --no-env-file src/web/start.ts dev",
    "server": "bun --no-env-file src/web/start.ts start",
    "typecheck": "node node_modules/next/dist/bin/next typegen && tsc --noEmit && tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:backend": "vitest run --config backend/vitest.config.ts",
    "test:opencode": "vitest run --config backend/vitest.opencode.config.ts",
    "think:fixture": "bun --no-env-file tests/think-fixture.ts",
    "test:watch": "vitest",
    "build": "node node_modules/next/dist/bin/next typegen && tsc --noEmit && node node_modules/next/dist/bin/next build",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@opencode/client": "2.2.2",
    "croner": "11.0.0",
    "hono": "4.13.14",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/server": "2.3.1",
    "@playwright/test": "1.64.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "30.1.3",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
